# Daycostra → AgentOS runtime federation
# Keep service credentials server-side. Never prefix these variables with VITE_ or expose them to browser bundles.

# Publicly reachable or local AgentOS base URL depending on environment.
# Example for local development: http://127.0.0.1:3000
DAYCOSTRA_AGENTOS_URL=

# AgentOS service credential sent server-to-server as X-AgentOS-Key.
# Do not commit a real value.
DAYCOSTRA_AGENTOS_API_KEY=

# disabled | development | authenticated
# Current Daycostra builds must remain disabled until the Authority S6 mission/delegation boundary is connected.
DAYCOSTRA_RUNTIME_EXECUTION_MODE=disabled
