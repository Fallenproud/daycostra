# Daycostra → governed runtime federation
# Keep service credentials server-side. Never prefix server secrets with VITE_ or expose them to browser bundles.

# ── Authority S6 ──────────────────────────────────────────────
# Canonical mission/delegation enforcement service.
# The recovered v0.5 contract requires Workload Identity + Delegation Lease credentials for execution.
# Example for local development: http://127.0.0.1:3100
DAYCOSTRA_AUTHORITY_S6_URL=

# ── AgentOS runtime substrate ─────────────────────────────────
# Publicly reachable or local AgentOS base URL depending on environment.
# Example for local development: http://127.0.0.1:3000
DAYCOSTRA_AGENTOS_URL=

# AgentOS service credential used only for server-to-server readiness/federation.
# This credential is NOT execution authority and must never be forwarded to the browser.
DAYCOSTRA_AGENTOS_API_KEY=

# disabled | development | authenticated
# Keep disabled until identity → mission → workload → lease → S6 → AgentOS is proven end-to-end.
DAYCOSTRA_RUNTIME_EXECUTION_MODE=disabled

# ── Clerk identity provider ───────────────────────────────────
# Install/wire @clerk/tanstack-react-start before enabling these in deployment.
# VITE_ is appropriate only for Clerk's publishable browser key; the secret key remains server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# ── Public site identity / SEO ────────────────────────────────
# Canonical absolute origin used by server-generated sitemap entries.
# Production default is https://daycostra.com when this is omitted.
SITE_URL=https://daycostra.com
VITE_SITE_URL=https://daycostra.com

# ── Public frontend content ───────────────────────────────────
# Sanity is the selected future CMS for /insights. These values only describe
# intended configuration; they DO NOT activate CMS reads until a real Sanity
# client/query implementation is added. Typed local editorial content remains active.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Optional real POST endpoint for /contact Request Access submissions.
# Leave empty in preview environments; the form will validate locally and clearly
# report that nothing was sent instead of showing a fake success state.
VITE_CONTACT_ENDPOINT=
